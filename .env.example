# Gerar .env.local com: pnpm auth:setup (ou .\configurar-acessos.ps1).
# Nenhuma senha padrão é fornecida. Sem a configuração, o livro fica fechado.
AUTH_ORIGIN=http://127.0.0.1:3000
AUTH_SESSION_SECRET=
AUTH_ANA_PASSWORD_HASH=
AUTH_PEDRO_PASSWORD_HASH=

# O configurador escapa os cifrões dos hashes para o leitor .env do Next.
# Nunca use NEXT_PUBLIC_ para segredos ou copie .env.local para o repositório.
# Configurar com pnpm db:setup (ou .\configurar-banco.ps1).
# pglite: PostgreSQL embarcado, persistente, somente para uso local.
# postgres: conexão PostgreSQL TCP, inclusive Railway.
DATABASE_MODE=
DATABASE_PATH=
DATABASE_URL=
# Certificado CA do banco, se ele usar certificado próprio. Não desativamos TLS.
DATABASE_SSL_CA=
# Para certificado próprio do Railway: certificado PEM do servidor, fixado por fingerprint.
DATABASE_SSL_CERT=
